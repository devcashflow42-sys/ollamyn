# ============================================================================
# ollamyn API - Variables de entorno (ejemplo)
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas tu `.env` real al repositorio.
# ============================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# URL pública de la API (usada en la documentación Swagger)
PUBLIC_API_URL=http://localhost:3000

# --- Base de datos PostgreSQL ---
# La aplicación cliente NUNCA se conecta directamente a PostgreSQL.
DATABASE_URL=postgresql://ollamyn:ollamyn@localhost:5432/ollamyn?schema=public

# --- Redis (opcional: caché + rate limiting distribuido) ---
# Si se deja vacío, el rate limiting usa memoria local del proceso.
REDIS_URL=

# --- JWT ---
# Genera secretos largos y aleatorios, p. ej.: openssl rand -hex 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-distinto-y-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Seguridad / CORS ---
# Lista separada por comas de orígenes permitidos. Usa "*" solo en desarrollo.
CORS_ORIGINS=*
# Tamaño máximo del body JSON aceptado por la API
REQUEST_BODY_LIMIT=1mb
# Rondas de hashing bcrypt
BCRYPT_ROUNDS=12

# --- Rate limiting ---
# Límite global de peticiones por ventana (protección básica anti-abuso)
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120
# Límite de solicitudes de IA por hora según plan
RATE_LIMIT_AI_WINDOW_MS=3600000
RATE_LIMIT_AI_FREE_MAX=20
RATE_LIMIT_AI_PREMIUM_MAX=500

# --- Almacenamiento de archivos ---
# Directorio local para adjuntos en desarrollo (adaptador de storage por defecto).
FILE_STORAGE_DIR=uploads
FILE_MAX_SIZE_BYTES=10485760

# ============================================================================
# Proveedores de IA — SOLO en el servidor, jamás expuestas al cliente.
# La API abstrae qué proveedor real usa cada modelo público (ollamyn-*).
# ============================================================================

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# NVIDIA NIM (https://build.nvidia.com) — API compatible con OpenAI
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# Google Gemini (https://ai.google.dev)
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Proveedor local / self-hosted (Ollama, vLLM, TGI...) — compatible con OpenAI
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_API_KEY=

# Semilla del administrador inicial (usado por `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@ollamyn.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
