// ============================================================================
// ollamyn API - Esquema de base de datos (Prisma + PostgreSQL)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum PlanTier {
  free
  premium
}

enum MessageRole {
  system
  user
  assistant
}

enum UsageStatus {
  success
  error
  timeout
  canceled
  rate_limited
}

// ----------------------------------------------------------------------------
// Usuarios
// ----------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         UserRole   @default(user)
  status       UserStatus @default(active)
  plan         PlanTier   @default(free)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  chats         Chat[]
  messages      Message[]
  files         File[]
  usage         AiUsage[]
  refreshTokens RefreshToken[]

  @@index([status])
  @@map("users")
}

/// Tokens de refresco almacenados como hash para permitir rotación y revocación.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// Modelos de IA (catálogo público de ollamyn-*)
// El proveedor real (provider / providerModel / config) NO se expone al cliente.
// ----------------------------------------------------------------------------

model AiModel {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  slug              String   @unique
  provider          String
  providerModel     String
  description       String?
  enabled           Boolean  @default(true)
  contextWindow     Int      @default(8192)
  supportsImages    Boolean  @default(false)
  supportsFiles     Boolean  @default(false)
  supportsStreaming Boolean  @default(true)
  config            Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  chats    Chat[]
  messages Message[]
  usage    AiUsage[]

  @@index([enabled])
  @@map("ai_models")
}

// ----------------------------------------------------------------------------
// Chats
// ----------------------------------------------------------------------------

model Chat {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String   @default("Nuevo chat")
  modelId   String?  @db.Uuid
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  model    AiModel?  @relation(fields: [modelId], references: [id], onDelete: SetNull)
  messages Message[]
  files    File[]
  usage    AiUsage[]

  @@index([userId, updatedAt])
  @@map("chats")
}

// ----------------------------------------------------------------------------
// Mensajes
// ----------------------------------------------------------------------------

model Message {
  id           String      @id @default(uuid()) @db.Uuid
  chatId       String      @db.Uuid
  userId       String      @db.Uuid
  role         MessageRole
  content      String      @db.Text
  modelId      String?     @db.Uuid
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int?
  createdAt    DateTime    @default(now())

  chat  Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model AiModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt])
  @@map("messages")
}

// ----------------------------------------------------------------------------
// Archivos adjuntos
// ----------------------------------------------------------------------------

model File {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  chatId    String?  @db.Uuid
  name      String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([chatId])
  @@map("files")
}

// ----------------------------------------------------------------------------
// Registro de consumo de IA
// ----------------------------------------------------------------------------

model AiUsage {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  modelId      String?     @db.Uuid
  chatId       String?     @db.Uuid
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  totalTokens  Int         @default(0)
  latencyMs    Int?
  status       UsageStatus @default(success)
  createdAt    DateTime    @default(now())

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model AiModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  chat  Chat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([modelId, createdAt])
  @@map("ai_usage")
}
